<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SoundDeck.App.Controls">

    <!-- ウィンドウとカードの色。ダークは黒、ライトは白の背景にする（透ける背景はグレーに見えるため使わない） -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SoundDeckWindowBackgroundBrush" Color="#000000" />
            <SolidColorBrush x:Key="SoundDeckCardBackgroundBrush" Color="#111111" />
            <SolidColorBrush x:Key="SoundDeckCardStrokeBrush" Color="#262626" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SoundDeckWindowBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SoundDeckCardBackgroundBrush" Color="#F6F6F6" />
            <SolidColorBrush x:Key="SoundDeckCardStrokeBrush" Color="#E3E3E3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SoundDeckWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SoundDeckCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SoundDeckCardStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        コードで組み立てる画面の色はスタイル経由で当てる。Application.Current.Resources から直接引いたブラシは
        アプリ全体のテーマの色に固定され、設定でダーク・ライトを選んだウィンドウの色に追従しないため
    -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SoundDeckCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SoundDeckCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="SecondaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="ErrorCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- 枠なしのアイコンボタン（Windows 11 のクイック設定にある小さなボタン） -->
    <Style x:Key="SubtleIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 音量スライダーの下に敷くピークメーター -->
    <Style x:Key="PeakMeterStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="3" />
        <Setter Property="RadiusX" Value="1.5" />
        <Setter Property="RadiusY" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="10,0,10,3" />
        <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="PeakTrackStyle" TargetType="Rectangle" BasedOn="{StaticResource PeakMeterStyle}">
        <Setter Property="Fill" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
        <Setter Property="Opacity" Value="0.25" />
    </Style>

    <!-- 設定画面の 1 行（Windows 11 の設定アプリのカード） -->
    <Style TargetType="controls:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource SoundDeckCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SoundDeckCardStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsCard">
                    <Grid
                        MinHeight="{TemplateBinding MinHeight}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ColumnSpacing="16"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="IconPart"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Glyph="{TemplateBinding Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="DescriptionPart"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{TemplateBinding Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter
                            Grid.Column="2"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,24,0,6" />
    </Style>
</ResourceDictionary>
