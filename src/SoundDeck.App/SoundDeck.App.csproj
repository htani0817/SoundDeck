<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(SoundDeckWindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>SoundDeck.App</RootNamespace>
    <AssemblyName>SoundDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- MSIX にしない（unpackaged）。Windows App Runtime も同梱して単体で起動できるようにする -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>Assets/SoundDeck.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- 画面のリソースを exe 名に依存しない名前にする（配布用に exe を SoundDeck-v1.0.0.exe などへ改名しても読み込めるように） -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- exe のプロパティ・タスクマネージャー・Windows の通知に出る名前 -->
    <Product>SoundDeck</Product>
    <AssemblyTitle>SoundDeck</AssemblyTitle>
    <Description>Windows 11 向けの音量ミキサー</Description>
    <Authors>htani0817</Authors>
    <Company>htani0817</Company>
    <Copyright>Copyright (c) 2026 htani0817</Copyright>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- 配布物にライセンス文を同梱する（Windows App SDK の再配布条件のため） -->
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SoundDeck.Core/SoundDeck.Core.csproj" />
    <ProjectReference Include="../SoundDeck.Audio/SoundDeck.Audio.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
